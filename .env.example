# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=
APP_SECRET_KEY=
APP_HOST=
APP_PORT=
# Comma-separated browser origins. Blank uses localhost:3000 and 127.0.0.1:3000
# in development. Must be set explicitly in production.
CORS_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── OpenAI (platform default — users supply their own per-tenant) ─────────────
OPENAI_API_KEY=

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Gmail / Google Cloud ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=

# ── MCP OAuth apps (optional — Slack/Notion refuse automatic registration) ────
# When set, Connect skips asking each user to paste a client ID/secret.
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
LINEAR_MCP_CLIENT_ID=
LINEAR_MCP_CLIENT_SECRET=
ATLASSIAN_MCP_CLIENT_ID=
ATLASSIAN_MCP_CLIENT_SECRET=

# ── Instagram ────────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Connector encryption ──────────────────────────────────────────────────────
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Public API origin (OAuth callbacks + inbound webhooks) ────────────────────
# Blank → http://localhost:{APP_PORT}. Production: https://api.setod.com
PUBLIC_BASE_URL=https://your-api-domain.com
WEBHOOK_SECRET=
TWILIO_WEBHOOK_SECRET=

# ── Stripe (billing; see BILLING.md) ──────────────────────────────────────────
# Test-mode keys from dashboard.stripe.com → Developers → API keys.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint (whsec_…), or `stripe listen` locally.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (platform notification emails from notifications@setod.com) ─────────
# Free tier covers ~3 000 emails/month. Get a key at resend.com.
RESEND_API_KEY=


# Code skills (user Python on Lambda in ca-central-1). Leave disabled until the feature is deployed.
CODE_SKILLS_ENABLED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USERCODE_DEPLOYER_ROLE_ARN=
AWS_USERCODE_EXEC_ROLE_ARN=
AWS_USERCODE_EXTERNAL_ID=
AWS_USERCODE_SUBNET_IDS=
AWS_USERCODE_SECURITY_GROUP_ID=
